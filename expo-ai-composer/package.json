{
  "name": "expo-ai-composer",
  "version": "0.1.0",
  "description": "A native keyboard-aware AI composer component for React Native with smooth keyboard animations and ChatGPT-style pin-to-top scroll",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    }
  },
  "files": [
    "build",
    "android/build.gradle",
    "android/src",
    "ios/*.podspec",
    "ios/*.swift",
    "expo-module.config.json",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "expo-module build",
    "clean": "expo-module clean",
    "lint": "expo-module lint",
    "test": "expo-module test",
    "prepare": "expo-module prepare",
    "prepack": "pnpm run build",
    "release:dry-run": "pnpm run build && npm publish --dry-run --access public --ignore-scripts",
    "release:publish": "pnpm run build && npm publish --access public --ignore-scripts"
  },
  "keywords": [
    "react-native",
    "expo",
    "keyboard",
    "composer",
    "ai",
    "chat",
    "keyboard-aware",
    "text-input",
    "pin-to-top",
    "streaming",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muratcakmak/expo-ai-chat.git",
    "directory": "expo-ai-composer"
  },
  "bugs": {
    "url": "https://github.com/muratcakmak/expo-ai-chat/issues"
  },
  "homepage": "https://github.com/muratcakmak/expo-ai-chat/tree/main/expo-ai-composer#readme",
  "author": "Oguzhan Cakmak",
  "license": "MIT",
  "devDependencies": {
    "@types/react": "~19.2.14",
    "expo": "^55.0.11",
    "expo-modules-core": "^55.0.14",
    "expo-module-scripts": "^55.0.2",
    "react": "19.2.4",
    "react-native": "0.84.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  }
}
