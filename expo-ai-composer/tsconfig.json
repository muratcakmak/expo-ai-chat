{
  "extends": "expo-module-scripts/tsconfig.base",
  "compilerOptions": {
    "outDir": "./build",
    // TS 6 requires an explicit rootDir when outDir is set. Jest types are only
    // needed by the tests, which are excluded from the build here and typechecked
    // separately via tsconfig.test.json.
    "rootDir": "./src",
    "types": []
  },
  "include": ["./src"],
  "exclude": ["**/__mocks__/*", "**/__tests__/*"]
}
