{
  "extends": "expo-module-scripts/tsconfig.base",
  "compilerOptions": {
    "outDir": "./build",
    // TS 6 requires an explicit rootDir when outDir is set; base config expects jest
    // types we don't use (no tests) — override to the packages actually imported.
    "rootDir": "./src",
    "types": []
  },
  "include": ["./src"],
  "exclude": ["**/__mocks__/*", "**/__tests__/*"]
}
